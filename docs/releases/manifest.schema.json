{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxsmolka/private-document-intelligence/blob/main/docs/releases/manifest.schema.json",
  "title": "PDI Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "release_commit", "backend_digest", "web_digest", "minimum_supported_version", "minimum_schema", "target_schema", "migration_required", "reindex_required", "backup_required", "rollback_mode", "release_notes_url", "architectures"],
  "properties": {
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$"},
    "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "backend_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "web_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "minimum_supported_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "minimum_schema": {"type": "string", "pattern": "^[0-9]{8}_[0-9]{4}$"},
    "target_schema": {"type": "string", "pattern": "^[0-9]{8}_[0-9]{4}$"},
    "migration_required": {"type": "boolean"},
    "reindex_required": {"type": "boolean"},
    "backup_required": {"type": "boolean"},
    "rollback_mode": {"enum": ["image_only", "restore_backup"]},
    "release_notes_url": {"type": "string", "pattern": "^https://github\\.com/maxsmolka/private-document-intelligence/"},
    "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["linux/amd64", "linux/arm64"]}}
  }
}
