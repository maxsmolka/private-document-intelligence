# Copy to .env.release, replace every CHANGE_ME value, and restrict file permissions.
PDI_VERSION=1.2.0
PDI_UPDATE_CHANNEL=manual
PDI_UPDATE_BACKEND_DIGEST=sha256:8780616a7863a0f9e27890689afd7821fadb098e4056deb2c125711d8a445473
PDI_UPDATE_WEB_DIGEST=sha256:3a3410b9d2dfbcc9fd2e50f3c074490b14d329265709521ab7983b0a073d9581
PDI_UPDATE_EXPECTED_SCHEMA=20260828_0017
PDI_POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
PDI_TOTP_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY
PDI_PUBLIC_URL=https://pdi.example.invalid
PDI_AUTH_SECURE_COOKIES=true
PDI_SETUP_ENABLED=true
PDI_LOG_LEVEL=INFO
# Optional consume profile. The scanner writes only to the inbox subdirectory.
PDI_CONSUME_HOST_PATH=./consume
PDI_CONSUME_STABILITY_SECONDS=10
PDI_CONSUME_POLL_INTERVAL=2
# Optional read-only mail profile. Keep the password in the protected file, not here.
PDI_IMAP_HOST=
PDI_IMAP_PORT=993
PDI_IMAP_USER=
PDI_IMAP_PASSWORD_FILE=./secrets/imap_password
PDI_IMAP_MAILBOX=INBOX
PDI_MAIL_POLL_INTERVAL=60
PDI_IMAP_MAX_MESSAGES_PER_POLL=100
PDI_IMAP_SOCKET_TIMEOUT_SECONDS=30
