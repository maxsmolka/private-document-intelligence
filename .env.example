PDI_ENV=development
PDI_DATABASE_URL=postgresql+asyncpg://pdi:pdi@localhost:5432/pdi
PDI_STORAGE_PATH=./storage
PDI_MAX_UPLOAD_SIZE=26214400
PDI_LOG_LEVEL=INFO
PDI_WORKER_POLL_INTERVAL=2
PDI_WORKER_MAX_ATTEMPTS=3
PDI_WORKER_JOB_TIMEOUT=300
PDI_WORKER_CONCURRENCY=1
PDI_WORKER_IDENTITY=
PDI_OCR_ENABLED=true
PDI_OCR_PROVIDER=ocrmypdf
PDI_OCR_COMMAND_TIMEOUT=180
PDI_OCR_LANGUAGE=deu+eng
PDI_OCR_MAX_PAGES=100
PDI_OCR_MAX_IMAGE_MPIXELS=100
PDI_OCR_FORCE_ROTATION=true
PDI_OCR_MAX_DERIVED_SIZE=104857600
PDI_INTELLIGENCE_PROVIDER=deterministic
PDI_INTELLIGENCE_TIMEOUT_SECONDS=60
PDI_INTELLIGENCE_MAX_INPUT_CHARACTERS=100000
PDI_OLLAMA_BASE_URL=http://localhost:11434
PDI_OLLAMA_MODEL=qwen2.5:7b
PDI_AUTH_ENABLED=true
PDI_SESSION_TTL_SECONDS=43200
PDI_AUTH_SECURE_COOKIES=false
PDI_LOGIN_MAX_ATTEMPTS=5
PDI_LOGIN_WINDOW_SECONDS=900
PDI_TOTP_ENCRYPTION_KEY=
PDI_CONSUME_PATH=./consume
PDI_CONSUME_PROCESSED_PATH=./consume-processed
PDI_CONSUME_FAILED_PATH=./consume-failed
PDI_CONSUME_STABILITY_SECONDS=10
PDI_CONSUME_POLL_INTERVAL=2
PDI_MAIL_ENABLED=false
PDI_IMAP_HOST=
PDI_IMAP_PORT=993
PDI_IMAP_USER=
PDI_IMAP_PASSWORD_FILE=
PDI_IMAP_MAILBOX=INBOX
PDI_MAIL_POLL_INTERVAL=60
PDI_PAPERLESS_URL=
PDI_PAPERLESS_TOKEN_FILE=
PDI_PAPERLESS_VERIFY_TLS=true
PDI_BACKUP_PATH=./backups
NEXT_PUBLIC_PDI_API_URL=http://localhost:8000
PDI_API_INTERNAL_URL=http://localhost:8000
